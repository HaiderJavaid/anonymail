---
import BaseLayout from '../layouts/BaseLayout.astro';

const downloadHref = '/downloads/anonymail-beta.zip';
const betaVersion = 'v0.1.1';
---
<BaseLayout title="Anonymail — a quiet disposable inbox for Chrome" description="Create one disposable inbox, fill signup forms, and read verification mail without leaving the page.">
  <header class="site-header landing-header wrap" data-adaptive-nav>
    <a class="logo" href="/" aria-label="Anonymail home"><img src="/anonymail.png" alt="" /><span>Anonymail</span></a>
    <nav aria-label="Main navigation"><a href="#how">How it works</a><a href="/privacy">Privacy</a><a class="nav-cta" href={downloadHref} download>Download latest beta</a></nav>
  </header>

  <main>
    <section class="hero wrap" data-reveal-group>
      <div class="hero-copy">
        <p class="kicker" data-reveal-item data-reveal-step="0"><span></span> Free privacy beta for Chrome</p>
        <h1 data-reveal-item data-reveal-step="1" data-reveal-emphasis>A disposable inbox that stays beside you.</h1>
        <p class="hero-body" data-reveal-item data-reveal-step="2">Right-click a signup field. Anonymail creates a private address, generates a different password, fills the form, and keeps verification mail in a calm side panel.</p>
        <div class="hero-actions" data-reveal-item data-reveal-step="3">
          <a class="button primary" href={downloadHref} download>Download latest beta</a>
          <a class="button secondary" href="#install">See installation steps</a>
        </div>
        <div class="beta-bar" aria-label={`Latest beta ${betaVersion}`} data-reveal-item data-reveal-step="4">
          <span>Latest beta</span>
          <b>{betaVersion}</b>
          <a href={downloadHref} download>Developer Mode ZIP</a>
        </div>
        <p class="microcopy" data-reveal-item data-reveal-step="5">No account · No analytics · One active inbox</p>
      </div>

      <div class="product-stage" aria-label="Anonymail dashboard preview" data-reveal-item data-reveal-step="6" data-reveal-product>
        <div class="demo-shell">
          <aside class="demo-nav">
            <img src="/anonymail.png" alt="" />
            <div class="demo-nav-item active">Inbox <b>2</b></div>
            <div class="demo-nav-item">Settings</div>
            <div class="demo-nav-item">Privacy</div>
            <p>One quiet inbox.<br />No tracking.</p>
          </aside>
          <div class="demo-main">
            <div class="demo-address"><small>ACTIVE DISPOSABLE ADDRESS</small><strong>a2bcde@x.test</strong><span>52m 14s remaining</span></div>
            <div class="demo-inbox">
              <div class="demo-title">Inbox <span>2</span></div>
              <div class="demo-row unread"><i></i><b>Acme</b><span>Confirm your email</span><time>Now</time></div>
              <div class="demo-row selected"><i>✓</i><b>Studio</b><span>Your verification code: 482901</span><time>1m</time></div>
              <div class="demo-row"><i>✓</i><b>Newsletter</b><span>Welcome aboard</span><time>3m</time></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip" data-reveal-group><div class="wrap"><span data-reveal-item data-reveal-step="0">Explicit website access</span><span data-reveal-item data-reveal-step="1">Separate mailbox and signup secrets</span><span data-reveal-item data-reveal-step="2">Automatic expiry</span><span data-reveal-item data-reveal-step="3">Powered by Mail.tm</span></div></section>

    <section id="how" class="section wrap" data-reveal-group>
      <p class="kicker" data-reveal-item data-reveal-step="0"><span></span> A smaller privacy ritual</p>
      <div class="section-heading"><h2 data-reveal-item data-reveal-step="1">From signup to verification without changing context.</h2><p data-reveal-item data-reveal-step="2">Anonymail stays intentionally narrow: one inbox, one clear action, and no permanent access to every site you visit.</p></div>
      <div class="feature-grid">
        <article data-reveal-item data-reveal-step="3">
          <video src="/media/right-click-fill.mp4" autoplay muted loop playsinline preload="metadata" aria-label="Right-clicking a signup field and choosing Fill with Anonymail"></video>
          <div><b>Right-click fill</b><p>Access begins only after your explicit action. Anonymail fills the enabled signup fields locally.</p></div>
        </article>
        <article data-reveal-item data-reveal-step="4">
          <video src="/media/side-panel-or-tab.mp4" autoplay muted loop playsinline preload="metadata" aria-label="Anonymail inbox open in Chrome’s side panel"></video>
          <div><b>Side panel or tab</b><p>Keep the inbox across tabs in the current Chrome window, or use the spacious dashboard.</p></div>
        </article>
        <article data-reveal-item data-reveal-step="5">
          <video src="/media/short-memory.mp4" autoplay muted loop playsinline preload="metadata" aria-label="Choosing a short mailbox lifetime in Anonymail settings"></video>
          <div><b>Matched memory</b><p>Choose 10 minutes, 1 hour, 6 hours, 24 hours, or until deleted. Signup passwords match that mailbox lifetime while staying session-only.</p></div>
        </article>
      </div>
    </section>

    <section id="install" class="install-section" data-reveal-group data-nav-theme="dark">
      <div class="wrap">
        <div class="tutorial-intro">
          <p class="kicker light" data-reveal-item data-reveal-step="0"><span></span> Installation tutorial</p>
          <h2 data-reveal-item data-reveal-step="1">Install Anonymail in Developer Mode.</h2>
          <p data-reveal-item data-reveal-step="2">Follow this short video to load the free Chrome beta.</p>
        </div>
        <div class="tutorial-player" data-reveal-item data-reveal-step="3">
          <iframe src="https://www.youtube-nocookie.com/embed/ucaRQlQ_Ojg?rel=0" title="How to install the Anonymail Developer Mode beta" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="tutorial-actions" data-reveal-item data-reveal-step="4"><p>Watch the tutorial, download the latest beta ZIP, then choose <strong>Load unpacked</strong>.</p><a class="button inverse" href={downloadHref} download>Download latest beta</a></div>
      </div>
    </section>

    <section class="privacy-section wrap" data-reveal-group>
      <div><p class="kicker" data-reveal-item data-reveal-step="0"><span></span> Privacy promise</p><h2 data-reveal-item data-reveal-step="1">Your browsing stays in your browser.</h2></div>
      <div data-reveal-item data-reveal-step="2"><p>Anonymail does not collect analytics, browsing history, signup URLs, or form contents. Mailbox operations go directly from the extension to Mail.tm.</p><a href="/privacy">Read the plain-English privacy policy →</a></div>
    </section>
  </main>

  <footer class="wrap"><a class="logo" href="/"><img src="/anonymail.png" alt="" /><span>Anonymail</span></a><p>Private signups, quietly handled.</p><div><a href="/privacy">Privacy</a><a href="https://mail.tm" target="_blank" rel="noreferrer">Mail.tm</a></div></footer>

  <script>
    const revealGroups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');
    document.documentElement.classList.add('reveal-ready');

    const revealObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('is-visible', entry.isIntersecting);
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    revealGroups.forEach((group) => revealObserver.observe(group));

    const header = document.querySelector<HTMLElement>('[data-adaptive-nav]');
    const darkSections = [...document.querySelectorAll<HTMLElement>('[data-nav-theme="dark"]')];
    let navFrame = 0;

    const updateNavigation = () => {
      navFrame = 0;
      if (!header) return;
      const isStuck = window.scrollY > 24;
      const navY = header.getBoundingClientRect().top + (header.offsetHeight / 2);
      const overDarkSection = darkSections.some((section) => {
        const bounds = section.getBoundingClientRect();
        return navY >= bounds.top && navY <= bounds.bottom;
      });
      header.classList.toggle('is-stuck', isStuck);
      header.classList.toggle('nav-over-dark', isStuck && overDarkSection);
    };

    const scheduleNavigationUpdate = () => {
      if (navFrame) return;
      navFrame = window.requestAnimationFrame(updateNavigation);
    };

    updateNavigation();
    window.addEventListener('scroll', scheduleNavigationUpdate, { passive: true });
    window.addEventListener('resize', scheduleNavigationUpdate);
  </script>
</BaseLayout>
