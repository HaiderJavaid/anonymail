{
  "name": "anonymail",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @anonymail/extension dev",
    "dev:site": "pnpm --filter @anonymail/site dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "zip": "pnpm --filter @anonymail/extension zip && node scripts/copy-release.mjs"
  }
}
